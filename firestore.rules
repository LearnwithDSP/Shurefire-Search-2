rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Collection: User Documents (Building plans, drawings, BOQ uploads)
    match /user_documents/{docId} {
      allow read, write: if true;
    }

    // Phase 5A: Construction Intelligence collections
    match /construction_projects/{projectId} {
      allow read, write: if true;
    }

    match /construction_documents/{docId} {
      allow read, write: if true;
    }

    match /construction_analyses/{analysisId} {
      allow read, write: if true;
    }

    match /construction_action_results/{actionId} {
      allow read, write: if true;
    }

    // Collection: Search answer caches
    match /search_cache/{cacheId} {
      allow read, write: if true;
    }

    // Collection: System Metadata
    match /system_metadata/{docId} {
      allow read, write: if true;
    }

    // Collection: Project Estimates
    match /project_estimates/{estimateId} {
      allow read, write: if true;
    }

    // Collection: Estimates Logs
    match /estimates/{estimateId} {
      allow read, write: if true;
    }

    // Collection: Materials Catalog
    match /materials/{materialId} {
      allow read, write: if true;
    }

    // Collection: Suppliers Directory
    match /suppliers/{supplierId} {
      allow read, write: if true;
    }

    // Collection: Sourcing and Quote Leads
    match /leads/{leadId} {
      allow read, write: if true;
    }

    // Collection: Knowledge Base Blocks
    match /knowledge_base/{blockId} {
      allow read, write: if true;
    }

    // Collection: User Profiles
    match /profiles/{profileId} {
      allow read, write: if true;
    }

    // Collection: Admins directory
    match /admins/{adminId} {
      allow read, write: if true;
    }

    // Collection: Connection Testing
    match /test/{docId} {
      allow read, write: if true;
    }

    // Default safety catch-all for any other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
